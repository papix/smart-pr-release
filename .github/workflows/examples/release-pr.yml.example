# Example workflow for smart-pr-release
#
# This workflow creates or updates a release PR when changes are pushed to main.
# Replace <FULL_COMMIT_SHA> with the complete reviewed smart-pr-release commit SHA,
# then copy this file to .github/workflows/release-pr.yml.

name: Release PR

on:
  push:
    branches: [main]

permissions: {}

jobs:
  release-pr:
    permissions:
      contents: read
      pull-requests: write
      issues: write
    uses: papix/smart-pr-release/.github/workflows/smart-pr-release.yml@<FULL_COMMIT_SHA>
    with:
      base_branch: production
      head_branch: main
      ai_provider: openai
      output_language: ja
    secrets:
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
