{
  "name": "smart-pr-release",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "AI-powered release PR automation for GitHub",
  "license": "MIT",
  "author": "papix",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.13.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/papix/smart-pr-release.git"
  },
  "imports": {
    "#core/*": "./packages/core/src/*"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:workflow": "node --test tests/workflow-toolchain.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "knip": "knip",
    "secretlint": "secretlint \"**/*\"",
    "publint": "pnpm -r exec publint",
    "attw": "pnpm --filter @papix/smart-pr-release-core exec attw --pack --profile node16 --ignore-rules cjs-resolves-to-esm",
    "prepare": "husky",
    "prepublishOnly": "pnpm run typecheck && pnpm test",
    "cli": "tsx packages/cli/src/index.ts"
  },
  "lint-staged": {
    "*.{ts,js,json,jsonc}": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched --error-on-warnings"
    ],
    "*": [
      "secretlint"
    ]
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.3.12",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.0.18",
    "dayjs": "^1.11.13",
    "husky": "^9.1.7",
    "knip": "6.27.0",
    "lint-staged": "^17.0.8",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-markdown": "2.1.2",
    "openai": "6.48.0",
    "publint": "^0.3.12",
    "secretlint": "^13.0.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
